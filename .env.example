# Docker Compose configuration — copy to .env and adjust. Never commit .env.

# PostgreSQL
POSTGRES_DB=quermed_crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# Backend
ENVIRONMENT=dev
LOG_LEVEL=info
JWT_SECRET=
WEB_CONCURRENCY=2
# Per-IP limit on /auth/*. Set to 1000/minute only when running the Playwright suite.
AUTH_RATE_LIMIT=10/minute
# Comma-separated. Include the frontend origin(s) and the LAN hostname pattern for mobile testing.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://*.local:5173,http://*.local:8080

# Frontend build (backend base URL only — no /api/v1 suffix)
VITE_API_URL=http://localhost:8000
