# crm.quermed.com — single origin for app and API (design D1).
# Caddy obtains and renews the Let's Encrypt certificate automatically and
# redirects plain HTTP to HTTPS on its own; DNS must resolve before first boot.

crm.quermed.com {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
