# Backend configuration — copy to .env for local runs outside Docker. Never commit .env.
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/quermed_crm
# At least 32 bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://*.local:5173,http://*.local:8080
ENVIRONMENT=dev
LOG_LEVEL=info
WEB_CONCURRENCY=2
